---
import { AstroFont } from 'astro-font'
import '../styles/global.css'
import { ClientRouter } from 'astro:transitions'
import Cursor from '@/components/Cursor'
import Header from '@/components/Header'
import InitialTransition from '@/components/InitialTransition'
import WebGLBackground from '@/components/WebGLBackground'

interface Props {
  title?: string
  description?: string
}

const SITE_URL = 'https://abrahamsm.com'

const {
  title = 'Abraham Serrano Montiel | Frontend Developer',
  description = 'Frontend Developer with 5+ years building high-traffic web apps. Delivered TUDN, Univision, Canal 5, and Hyundai configurators using React, Next.js, SSR, and GraphQL.'
} = Astro.props

const canonicalURL = new URL(Astro.url.pathname, SITE_URL).href

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Abraham Serrano Montiel',
  jobTitle: 'Frontend Developer',
  url: SITE_URL,
  email: 'abrahamserrano96@hotmail.com',
  image: `${SITE_URL}/asmLogo-big.jpg`,
  sameAs: [
    'https://github.com/AbrahamSM96',
    'https://www.linkedin.com/in/abraham-serranom'
  ],
  homeLocation: {
    '@type': 'Place',
    name: 'Pachuca, Hidalgo, Mexico'
  },
  worksFor: {
    '@type': 'Organization',
    name: 'TelevisaUnivision'
  },
  knowsAbout: [
    'React',
    'Next.js',
    'JavaScript',
    'TypeScript',
    'GraphQL',
    'Tailwind CSS',
    'SSR',
    'Web Performance',
    'SEO'
  ],
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'Universidad Autónoma del Estado de Hidalgo',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Pachuca',
      addressRegion: 'Hidalgo',
      addressCountry: 'MX'
    }
  }
})
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" href="/asm_logo.png" />
    <link rel="apple-touch-icon" href="/asm_logo.png" />
    <meta name="generator" content={Astro.generator} />
    <meta id="theme-color-meta" content="#0A0B0B" name="theme-color" />
    <meta
      name="google-site-verification"
      content="gxdbqKjT2eHsw2NPwRE-NIlkHBsd2PRhcFZ_Nckf61o"
    />
    <!-- Primary meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content="index, follow, max-snippet:160, max-image-preview:large"
    />
    <link rel="canonical" href={canonicalURL} />
    <meta name="author" content="Abraham Serrano Montiel" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Abraham Serrano" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={`${SITE_URL}/asmLogo-big.jpg`} />
    <meta property="og:image:width" content="1254" />
    <meta property="og:image:height" content="1254" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE_URL}/asmLogo-big.jpg`} />

    <!-- Structured data -->
    <script is:inline type="application/ld+json" set:html={jsonLd} />

    <!-- Preconnect to Google Fonts to eliminate DNS + TLS round-trips -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <AstroFont
      config={[
        {
          src: [],
          name: 'Nunito',
          googleFontsURL:
            'https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,200..1000;1,200..1000&display=swap',
          preload: true,
          display: 'swap',
          selector: 'body',
          fallback: 'sans-serif',
          cssVariable: '--font-nunito'
        }
      ]}
    />
    <ClientRouter />
  </head>
  <body>
    <div
      id="intro-cover"
      style="position:fixed;inset:0;background:#000;z-index:999;pointer-events:none;"
    >
    </div>
    <script is:inline>
      if (sessionStorage.getItem('intro-played')) {
        document.getElementById('intro-cover').style.display = 'none'
      }
    </script>
    <WebGLBackground client:only="react" />
    <!-- Only download the cursor bundle on devices that actually have a pointer -->
    <Cursor client:media="(hover: hover) and (pointer: fine)" />
    <InitialTransition client:only="react" />
    <Header client:only />
    <slot />
  </body>
</html>

<style is:global>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }

  html {
    background-color: rgb(64, 0, 76);
  }

  :root {
    color-scheme: dark;
    --background: rgb(4, 2, 8);
    --background-secondary: rgba(18, 4, 22, 0.82);
    --white-icon: rgba(255, 255, 255, 0.65);
    --primary: rgb(147, 51, 234);
    --textPrimary: rgba(255, 255, 255, 0.92);
  }

  [data-theme='light'] {
    color-scheme: light;
  }
</style>
