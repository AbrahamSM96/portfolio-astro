</section>

<style>
  .project-tag {
    @apply rounded-full border border-white/15 px-2.5 py-0.5 text-xs text-white/50 transition-colors;
  }
  .project-row:hover .project-tag {
    @apply border-purple-400/25 text-purple-300/70;
  }
  .project-num {
    font-variant-numeric: tabular-nums;
    transition: color 0.2s;
  }
  .project-row:hover .project-num {
    color: rgba(167, 139, 250, 0.6);
  }
</style>

<script>
  import gsap from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'

  gsap.registerPlugin(ScrollTrigger)

  const cardTriggers: ScrollTrigger[] = []

  function initProjects() {
    cardTriggers.forEach((t) => t.kill())
    cardTriggers.length = 0

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    if (reduced) {
      document.querySelectorAll<HTMLElement>('[data-reveal-card]').forEach((el) => {
        el.style.opacity = '1'
      })
      return
    }

    const heading = document.querySelector<HTMLElement>('[data-reveal-card="heading"]')
    if (heading) {
      gsap.set(heading, { opacity: 0, y: 32 })
      cardTriggers.push(
        ScrollTrigger.create({
          trigger: heading,
          start: 'top 85%',
          once: true,
          onEnter: () => gsap.to(heading, { opacity: 1, y: 0, duration: 0.8, ease: 'power3.out' }),
        })
      )
    }

    const rows = gsap.utils.toArray<HTMLElement>('[data-reveal-card="card"]')
    rows.forEach((row, i) => {
      gsap.set(row, { opacity: 0, y: 24 })
      cardTriggers.push(
        ScrollTrigger.create({
          trigger: row,
          start: 'top 88%',
          once: true,
          onEnter: () =>
            gsap.to(row, {
              opacity: 1,
              y: 0,
              duration: 0.6,
              ease: 'power3.out',
              delay: i * 0.06,
            }),
        })
      )
    })
  }

  document.addEventListener('astro:page-load', initProjects)
</script>
