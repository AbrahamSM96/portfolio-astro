<style>
  .proj-tag {
    @apply rounded-full border border-white/10 px-2.5 py-0.5 text-xs text-white/50 transition-colors;
  }
  .proj-row:hover .proj-tag {
    @apply border-purple-400/25 text-purple-300/70;
  }
  .proj-row:hover .proj-num {
    color: rgba(167, 139, 250, 0.6);
  }
</style>

<script>
  import gsap from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'

  gsap.registerPlugin(ScrollTrigger)

  function initProjectsPage() {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    if (reduced) return

    // Hero
    const heroEls = [
      document.querySelector('.projects-label'),
      document.querySelector('.projects-title'),
      document.querySelector('.projects-meta'),
    ].filter(Boolean) as HTMLElement[]

    if (heroEls.length) {
      gsap.set(heroEls, { opacity: 0, y: 40 })
      gsap.to(heroEls, {
        opacity: 1, y: 0,
        duration: 0.9, ease: 'power3.out', stagger: 0.12, delay: 0.15,
      })
    }

    // Stats
    gsap.utils.toArray<HTMLElement>('.proj-stat').forEach((el, i) => {
      gsap.set(el, { opacity: 0, y: 30 })
      ScrollTrigger.create({
        trigger: el, start: 'top 85%', once: true,
        onEnter: () => gsap.to(el, { opacity: 1, y: 0, duration: 0.7, ease: 'power3.out', delay: i * 0.08 }),
      })
    })

    // Project rows
    gsap.utils.toArray<HTMLElement>('.proj-row').forEach((row, i) => {
      gsap.set(row, { opacity: 0, y: 28 })
      ScrollTrigger.create({
        trigger: row, start: 'top 88%', once: true,
        onEnter: () => gsap.to(row, { opacity: 1, y: 0, duration: 0.65, ease: 'power3.out', delay: i * 0.05 }),
      })
    })

    // CTA
    const ctaText  = document.querySelector('.proj-cta-text')
    const ctaLinks = document.querySelector('.proj-cta-links')
    if (ctaText && ctaLinks) {
      gsap.set([ctaText, ctaLinks], { opacity: 0, y: 32 })
      ScrollTrigger.create({
        trigger: ctaText, start: 'top 85%', once: true,
        onEnter: () => {
          gsap.to(ctaText,  { opacity: 1, y: 0, duration: 0.8, ease: 'power3.out' })
          gsap.to(ctaLinks, { opacity: 1, y: 0, duration: 0.8, ease: 'power3.out', delay: 0.15 })
        },
      })
    }
  }

  document.addEventListener('astro:page-load', initProjectsPage)
</script>
