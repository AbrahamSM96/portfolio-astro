          <div class="flex flex-wrap gap-2">
            <span class="proj-tag">Next.js</span>
            <span class="proj-tag">React</span>
            <span class="proj-tag">GraphQL</span>
            <span class="proj-tag">Zustand</span>
            <span class="proj-tag">Tailwind CSS</span>
