<style>
  .about-tag {
    @apply rounded-full border border-white/10 px-3 py-1 text-xs text-white/50 transition-colors hover:border-purple-400/30 hover:text-purple-300/70;
  }
</style>

<script>
  import gsap from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'

  gsap.registerPlugin(ScrollTrigger)

  function initAbout() {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    if (reduced) return

    // Hero stagger on load
    const heroEls = [
      document.querySelector('.about-label'),
      document.querySelector('.about-name'),
      document.querySelector('.about-meta'),
    ].filter(Boolean) as HTMLElement[]

    if (heroEls.length) {
      gsap.set(heroEls, { opacity: 0, y: 40 })
      gsap.to(heroEls, {
        opacity: 1,
        y: 0,
        duration: 0.9,
        ease: 'power3.out',
        stagger: 0.12,
        delay: 0.15,
      })
    }

    // Stats
    const stats = gsap.utils.toArray<HTMLElement>('.stat-item')
    stats.forEach((el, i) => {
      gsap.set(el, { opacity: 0, y: 30 })
      ScrollTrigger.create({
        trigger: el,
        start: 'top 85%',
        once: true,
        onEnter: () =>
          gsap.to(el, { opacity: 1, y: 0, duration: 0.7, ease: 'power3.out', delay: i * 0.08 }),
      })
    })

    // Who I am columns
    const left  = document.querySelector('.about-left')
    const right = document.querySelector('.about-right')
    if (left && right) {
      gsap.set([left, right], { opacity: 0, y: 40 })
      ScrollTrigger.create({
        trigger: left,
        start: 'top 80%',
        once: true,
        onEnter: () => {
          gsap.to(left,  { opacity: 1, y: 0, duration: 0.8, ease: 'power3.out' })
          gsap.to(right, { opacity: 1, y: 0, duration: 0.8, ease: 'power3.out', delay: 0.12 })
        },
      })
    }

    // Skill groups
    const groups = gsap.utils.toArray<HTMLElement>('.skill-group')
    groups.forEach((g, i) => {
      gsap.set(g, { opacity: 0, y: 24 })
      ScrollTrigger.create({
        trigger: g,
        start: 'top 88%',
        once: true,
        onEnter: () =>
          gsap.to(g, { opacity: 1, y: 0, duration: 0.6, ease: 'power3.out', delay: i * 0.07 }),
      })
    })

    // CTA
    const ctaText  = document.querySelector('.about-cta-text')
    const ctaLinks = document.querySelector('.about-cta-links')
    if (ctaText && ctaLinks) {
      gsap.set([ctaText, ctaLinks], { opacity: 0, y: 32 })
      ScrollTrigger.create({
        trigger: ctaText,
        start: 'top 85%',
        once: true,
        onEnter: () => {
          gsap.to(ctaText,  { opacity: 1, y: 0, duration: 0.8, ease: 'power3.out' })
          gsap.to(ctaLinks, { opacity: 1, y: 0, duration: 0.8, ease: 'power3.out', delay: 0.15 })
        },
      })
    }
  }

  document.addEventListener('astro:page-load', initAbout)
</script>
